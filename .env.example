# Copy this file to .env and fill in the keys.
# Generate strong keys with: npm run generate-keys

# Required: key portal servers use to register (min 16 chars)
PORTAL_REGISTER_KEY=

# Required: key clients use to join (min 16 chars, must differ from register key)
PORTAL_JOIN_KEY=

# Optional: port for the HTTP/WebSocket server (default: 3069)
#PORTAL_LISTEN_PORT=3069

# Optional: log level: DEBUG, INFO, WARN, ERROR (default: INFO)
#LOG_LEVEL=INFO

# Optional: hardening limits (defaults shown)
#PORTAL_MAX_PAYLOAD_BYTES=65536
#PORTAL_MAX_CONNECTIONS=1000
#PORTAL_AUTH_TIMEOUT_MS=10000
#PORTAL_HEARTBEAT_INTERVAL_MS=30000
#PORTAL_MAX_AUTH_FAILURES_PER_MINUTE=10
